# Shubha Muhurta backend configuration (copy to .env). All optional.
# Database — SQLite by default; point at PostgreSQL for production.
# SM_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/shubha

# CORS — comma-separated allowed origins for the SPA.
# SM_CORS_ORIGINS=http://localhost:5173

# Upload limit (bytes). Default 10 MB.
# SM_MAX_UPLOAD_BYTES=10485760

# --- Authentication / authorization ---
# Guest/local mode by default. Set true ONLY for shared/internet deployment.
# SM_AUTH_REQUIRED=false
# Token signing secret. If unset, a random key is generated and persisted to
# storage/.secret_key. Set a strong value in production (keep it secret).
# SM_SECRET_KEY=
# SM_ACCESS_TTL_MIN=720
# SM_LOGIN_RATE_LIMIT=10
# SM_LOGIN_RATE_WINDOW_SEC=300

# --- Optional AI assistance (leave blank to keep fully offline) ---
# The app works with no AI configured. Never commit real keys.
# SM_AI_PROVIDER=anthropic
# SM_AI_API_KEY=
# SM_AI_MODEL=claude-sonnet-5
# SM_AI_IMAGE_PROVIDER=
